/// Empty rows and columns are now a million times larger, not twice. An expanded
/// grid would be some 140 million squares on a side, which is the point: nothing
/// is expanded, only the coordinates are.
///
/// That makes part 2 the same program as part 1 with a different factor, so the
/// factor is a second argument — `sigil exec part2.sg -- sample.txt 10` gives
/// 1030 and `... sample.txt 100` gives 8410, the two checks the puzzle offers for
/// the scaling itself. Left alone it is the million the puzzle asks for.
///
/// Distances need no pathfinding: with only orthogonal steps and no obstacles,
/// the shortest path between two galaxies is the Manhattan distance, and paths
/// are allowed to run straight through other galaxies.
///
/// Advent of Code 2023, day 11, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Galaxy = { c: Int, r: Int }

fn galaxies(grid: List[Str]) -> List[Galaxy] {
  List.range(0, grid.len()).flat_map(fn(r) {
    let row = grid.get(r).unwrap_or("")
    List.range(0, row.len())
      .filter(fn(c) { row.slice(c, c + 1) == "#" })
      .map(fn(c) { { c:, r: } })
  })
}

/// Where coordinates on one axis land: the shift is a running total of the empty
/// lines before them, each worth `factor - 1` extra, tabulated once and then looked
/// up per galaxy.
fn expanded(values: List[Int], extent: Int, factor: Int) -> List[Int] {
  let table = List.range(0, extent).fold({ shift: 0, moved: Map.empty() }, fn(state, index) {
    let grown = if values.contains(index) { state.shift } else { state.shift + factor - 1 }
    { shift: grown, moved: Map.insert(state.moved, index, index + state.shift) }
  }).moved
  values.map(fn(value) { Map.get(table, value).unwrap_or(value) })
}

/// Manhattan distance splits into two axes that never interact, and one sorted axis
/// needs no pairs at all: each value sits to the right of every earlier one, adding
/// itself once per value seen, less the sum of those values.
fn axis_total(values: List[Int]) -> Int {
  values.sorted().fold({ seen: 0, before: 0, total: 0 }, fn(state, value) {
    { seen: state.seen + 1,
      before: state.before + value,
      total: state.total + value * state.seen - state.before }
  }).total
}

fn total_distance(found: List[Galaxy], grid: List[Str], factor: Int) -> Int {
  let width = grid.first().unwrap_or("").len()
  axis_total(expanded(found.map(fn(galaxy) { galaxy.r }), grid.len(), factor))
    + axis_total(expanded(found.map(fn(galaxy) { galaxy.c }), width, factor))
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let grid = (try Fs.read_lines(sys.fs.read, path)).reject(fn(line) { line == "" })
  let found = galaxies(grid)
  let factor = match sys.args.get(1) {
    None => 1000000
    Some(raw) => try Int.parse(raw)
  }
  sys.console.print("galaxies: " ++ Int.to_str(found.len()) ++ ", expansion factor: " ++ Int.to_str(factor))
  sys.console.print("sum of distances: " ++ Int.to_str(total_distance(found, grid, factor)))
  Ok(())
}
