/// Every mirror has exactly one smudge — one `.` or `#` that should be the other
/// — and fixing it reveals a *different* line of reflection. Score those instead:
/// 300 + 100 = 400 on `sample.txt`.
///
/// The smudge is never located and never repaired. A fold hiding one smudge is
/// precisely a fold across which exactly one character disagrees, so asking
/// `smudges` for 1 instead of 0 answers part 2 outright. That also disposes of
/// the warning that the old line may stop being valid: the old line had zero
/// disagreements, so it can never be mistaken for the new one, and no bookkeeping
/// is needed to exclude it.
///
/// A vertical fold is a horizontal fold of the transposed pattern, so only one
/// direction is ever implemented.
///
/// Advent of Code 2023, day 13, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

fn parse_pattern(block: Str) -> List[Str] {
  block.trim().lines()
}

/// Columns become rows, so one fold-finder serves both directions.
fn transpose(rows: List[Str]) -> List[Str] {
  let width = rows.first().unwrap_or("").len()
  List.range(0, width).map(fn(c) {
    rows.map(fn(row) { row.slice(c, c + 1) }).join("")
  })
}

fn differences(a: Str, b: Str) -> Int {
  List.zip(a.chars(), b.chars()).count(fn(pair) { pair.first != pair.second })
}

/// How many characters disagree across a fold between rows `above - 1` and
/// `above`. Pairing the rows above (innermost first) against the rows below stops
/// at whichever side runs out, so rows that would reflect off the end of the
/// pattern are simply never paired — which is what lets an off-centre fold count.
fn smudges(rows: List[Str], above: Int) -> Int {
  List.zip(rows.take(above).reverse(), rows.drop(above))
    .map(fn(pair) { differences(pair.first, pair.second) })
    .sum()
}

/// The fold with exactly `wanted` disagreements, as a count of rows above it.
fn fold_at(rows: List[Str], wanted: Int) -> Option[Int] {
  List.range(1, rows.len()).find(fn(above) { smudges(rows, above) == wanted })
}

fn summarise(rows: List[Str], wanted: Int) -> Result[Int, Str] {
  match fold_at(rows, wanted) {
    Some(above) => Ok(100 * above)
    None => match fold_at(transpose(rows), wanted) {
      Some(left) => Ok(left)
      None => Err("no line of reflection in:\n" ++ rows.join("\n"))
    }
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let patterns = Fs.read_text(sys.fs.read, path)?.trim().split("\n\n").map(parse_pattern)
  let total = patterns.try_map(fn(rows) { summarise(rows, 1) })?.sum()
  sys.console.print("patterns: " ++ Int.to_str(patterns.len()))
  sys.console.print("summary: " ++ Int.to_str(total))
  Ok(())
}
