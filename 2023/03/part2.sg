/// A gear is a `*` touching exactly two part numbers, and its ratio is those two
/// multiplied. Sum every gear's ratio: on `sample.txt` that is 467 * 35 plus
/// 598 * 755, or 467835. The `*` beside 617 touches only one number and is not a
/// gear.
///
/// Part 1 asked which numbers a symbol reaches, so it indexed the symbols. This
/// asks which numbers a `*` reaches, so it indexes the other way: every cell a
/// digit run covers maps to that run's position in the list. Looking up the eight
/// neighbours of a `*` and taking the distinct hits identifies the numbers it
/// touches — by index, so a run spanning three cells is still counted once, and
/// two different runs that happen to share a value stay distinct.
///
/// Advent of Code 2023, day 3, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Num = { hi: Int, lo: Int, row: Int, value: Int }

type Scan = { digits: Str, out: List[Num], start: Int }

fn is_digit(character: Str) -> Bool {
  Result.is_ok(Int.parse(character))
}

fn key(row: Int, col: Int) -> Int {
  row * 1000 + col
}

fn Scan.flush(scan: Scan, row: Int, col: Int) -> Scan {
  if scan.start == -1 {
    scan
  } else {
    let found = { hi: col - 1, lo: scan.start, row:, value: Int.parse(scan.digits).unwrap_or(0) }
    { digits: "", out: scan.out.push(found), start: -1 }
  }
}

fn row_numbers(row: Int, line: Str) -> List[Num] {
  let characters = line.chars()
  let width = characters.len()
  let { out: } = List.range(0, width + 1).fold({ digits: "", out: [], start: -1 }, fn(scan, col) {
    let character = characters.get(col).unwrap_or(".")
    if is_digit(character) {
      if scan.start == -1 {
        { digits: character, out: scan.out, start: col }
      } else {
        { digits: scan.digits ++ character, out: scan.out, start: scan.start }
      }
    } else {
      Scan.flush(scan, row, col)
    }
  })
  out
}

fn numbers(lines: List[Str]) -> List[Num] {
  List.range(0, lines.len()).flat_map(fn(row) { row_numbers(row, lines.get(row).unwrap_or("")) })
}

/// Every cell a run covers, mapped to that run's index in `found`.
fn number_cells(found: List[Num]) -> Map[Int, Int] {
  List.zip(List.range(0, found.len()), found).fold(Map.empty(), fn(cells, pair) {
    List.range(pair.second.lo, pair.second.hi + 1).fold(cells, fn(inner, col) {
      Map.insert(inner, key(pair.second.row, col), pair.first)
    })
  })
}

fn stars(lines: List[Str]) -> List[Int] {
  List.range(0, lines.len()).flat_map(fn(row) {
    let characters = lines.get(row).unwrap_or("").chars()
    List.range(0, characters.len())
      .filter(fn(col) { characters.get(col).unwrap_or(".") == "*" })
      .map(fn(col) { key(row, col) })
  })
}

fn neighbours(at: Int) -> List[Int] {
  List.range(-1, 2).flat_map(fn(row) { List.range(-1, 2).map(fn(col) { at + row * 1000 + col }) })
}

/// The ratio of a `*`, or nothing when it does not touch exactly two runs.
fn ratio(cells: Map[Int, Int], found: List[Num], at: Int) -> Option[Int] {
  let touching = neighbours(at).map(fn(cell) { Map.get(cells, cell) }).compact().uniq()
  if touching.len() == 2 {
    Some(touching.fold(1, fn(product, index) {
      product * found.get(index).map(fn(number) { number.value }).unwrap_or(1)
    }))
  } else {
    None
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let lines = (try Fs.read_lines(sys.fs.read, path)).reject(fn(line) { line == "" })
  let found = numbers(lines)
  let cells = number_cells(found)
  let total = stars(lines).map(fn(at) { ratio(cells, found, at) }).compact().sum()
  sys.console.print("sum of gear ratios: " ++ Int.to_str(total))
  Ok(())
}
