/// The letters and counts were never the plan — the colours were. Each six-digit
/// hex code is a five-digit distance followed by one digit for the direction,
/// `0RDLU`. Total volume: 952408144115 on `sample.txt`.
///
/// The lagoon is now millions of metres across, so any approach that touches
/// individual squares is finished. This one never did: it only ever visits the
/// corners, of which there are still exactly as many as before.
///
/// The trench is a closed loop, so this is day 10's problem again and takes the
/// same answer. The shoelace formula gives the area of the polygon the corners
/// describe, and Pick's theorem relates that to lattice points:
/// `A = interior + boundary / 2 - 1`. What is wanted is interior *plus* boundary —
/// the trench counts as dug — so the two rearrange to
/// `total = A + boundary / 2 + 1`. No grid is ever built, which is what lets part 2
/// use this unchanged at a scale where a grid would be hopeless.
///
/// Advent of Code 2023, day 18, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type FsErr =
  | Denied(path: Str)
  | NotFound(path: Str)

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Dig = { dc: Int, distance: Int, dr: Int }

/// Corner reached so far, the doubled shoelace sum, and the trench length.
type Walk = { c: Int, doubled: Int, edge: Int, r: Int }

fn fs_message(error: FsErr) -> Str {
  match error {
    Denied(path) => "denied " ++ path
    NotFound(path) => "not found " ++ path
  }
}

fn read_lines(fs: Fs, path: Str) -> Result[List[Str], Str] {
  match fs.read(path) {
    Err(error) => Err("could not read " ++ path ++ ": " ++ fs_message(error))
    Ok(text) => Ok(text.trim().split("\n").reject(fn(line) { line.trim() == "" }))
  }
}

fn heading(letter: Str) -> Result[Dig, Str] {
  if letter == "R" {
    Ok({ dc: 1, distance: 0, dr: 0 })
  } else if letter == "L" {
    Ok({ dc: 0 - 1, distance: 0, dr: 0 })
  } else if letter == "U" {
    Ok({ dc: 0, distance: 0, dr: 0 - 1 })
  } else if letter == "D" {
    Ok({ dc: 0, distance: 0, dr: 1 })
  } else {
    Err("unknown direction: " ++ letter)
  }
}

/// `Int.parse` reads decimal, so hex is folded by hand.
fn parse_hex(digits: Str) -> Result[Int, Str] {
  digits.chars().try_map(fn(digit) {
    Str.index_of("0123456789abcdef", digit.to_lower()).ok_or("not a hex digit: " ++ digit)
  }).map(fn(values) { values.fold(0, fn(total, value) { total * 16 + value }) })
}

/// The colour, stripped of its `(#` and `)`: five digits of distance, then one
/// naming the direction.
fn parse_dig(line: Str) -> Result[Dig, Str] {
  let parts = line.words()
  let colour = parts.get(2).ok_or("expected `<dir> <count> (<colour>)`, got: " ++ line)?
  let code = colour.replace("(", "").replace(")", "").replace("#", "")
  if code.len() != 6 {
    Err("expected six hex digits, got: " ++ colour)
  } else {
    let step = heading(["R", "D", "L", "U"].get(parse_hex(code.slice(5, 6))?).ok_or("unknown direction in: " ++ colour)?)?
    Ok({ dc: step.dc, distance: parse_hex(code.slice(0, 5))?, dr: step.dr })
  }
}

fn walk(plan: List[Dig]) -> Walk {
  plan.fold({ c: 0, doubled: 0, edge: 0, r: 0 }, fn(at, dig) {
    let nr = at.r + dig.dr * dig.distance
    let nc = at.c + dig.dc * dig.distance
    { c: nc, doubled: at.doubled + at.c * nr - nc * at.r, edge: at.edge + dig.distance, r: nr }
  })
}

fn lagoon(plan: List[Dig]) -> Int {
  let traced = walk(plan)
  Int.abs(traced.doubled) / 2 + traced.edge / 2 + 1
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let plan = read_lines(sys.fs, path)?.try_map(parse_dig)?
  sys.console.print("cubic metres of lava: " ++ Int.to_str(lagoon(plan)))
  Ok(())
}
