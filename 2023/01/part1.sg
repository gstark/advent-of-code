/// Each line of the calibration document hides a two-digit number: its first
/// digit and its last digit, in that order. Sum them. On `sample.txt` the four
/// lines give 12, 38, 15, 77 — 142 in total.
///
/// Advent of Code 2023, day 1, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

/// `Int.parse` is the digit test: a single character either names an integer or
/// it does not, and the failure is exactly the "not a digit" answer wanted here.
fn digit_of(character: Str) -> Option[Int] {
  Result.ok(Int.parse(character))
}

fn digits(line: Str) -> List[Int] {
  line.chars().map(digit_of).compact()
}

/// A line with no digit at all is an error rather than a zero — the puzzle
/// promises one, so a line without one means the input was misread.
fn calibration(line: Str) -> Result[Int, Str] {
  let found = digits(line)
  let first = try found.first().ok_or("no digit on line: " ++ line)
  let last = try found.last().ok_or("no digit on line: " ++ line)
  Ok(first * 10 + last)
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let total = (try (try Fs.read_lines(sys.fs.read, path)).reject(fn(line) { line == "" }).try_map(calibration)).sum()
  sys.console.print("sum of calibration values: " ++ Int.to_str(total))
  Ok(())
}
