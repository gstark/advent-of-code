/// Forget the listed parts: each rating runs 1 to 4000, and the question is how
/// many of the 4000^4 combinations the workflows accept. 167409079868000 on
/// `sample.txt`.
///
/// Two hundred and fifty-six trillion parts cannot be sorted one at a time, so a
/// whole box of them is sorted at once — a range per rating, starting at 1..4000
/// on all four. A rule cuts its box in two along one axis: the part that satisfies
/// the test goes to the rule's destination, the part that fails carries on to the
/// next rule in the workflow. Neither piece is ever examined again by the other
/// branch, so no combination is counted twice and none is missed. A box reaching
/// `A` contributes the product of its four range widths; one reaching `R`, or one
/// that has been cut down to nothing, contributes zero.
///
/// Part 1 walked one part through the workflows; this walks a box through the same
/// graph, splitting rather than choosing. That the two agree on which parts are
/// accepted is the whole argument for its correctness.
///
/// Advent of Code 2023, day 19, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Rule = { dest: Str, field: Str, above: Bool, value: Int }

/// Inclusive at both ends; `lo > hi` means empty.
type Span = { hi: Int, lo: Int }

fn parse_rule(text: Str) -> Result[Rule, Str] {
  let halves = text.split(":")
  if halves.len() == 1 {
    Ok({ dest: text, field: "", above: false, value: 0 })
  } else {
    let bad = "expected `<test>:<dest>`, got: " ++ text
    let test = try halves.get(0).ok_or(bad)
    let above = test.contains(">")
    let sides = test.split(if above { ">" } else { "<" })
    let malformed = "expected `<field><op><value>`, got: " ++ test
    Ok({
      dest: try halves.get(1).ok_or(bad),
      field: try sides.get(0).ok_or(malformed),
      above:,
      value: try Int.parse(try sides.get(1).ok_or(malformed)),
    })
  }
}

fn parse_workflow(line: Str) -> Result[{ name: Str, rules: List[Rule] }, Str] {
  let bad = "expected `<name>{<rules>}`, got: " ++ line
  let halves = (try line.strip_suffix("}").ok_or(bad)).split("{")
  Ok({
    name: try halves.get(0).ok_or(bad),
    rules: try (try halves.get(1).ok_or(bad)).split(",").try_map(parse_rule),
  })
}

fn width(span: Span) -> Int {
  Int.max(0, span.hi - span.lo + 1)
}

/// A box is a span per rating, keyed by the field's letter, so a rule can read
/// and replace the one axis it tests without spelling out the four cases.
fn combinations(box: Map[Str, Span]) -> Int {
  Map.values(box).fold(1, fn(total, span) { total * width(span) })
}

/// The half of `span` that satisfies the rule, and the half that does not.
fn split(span: Span, rule: Rule) -> { fails: Span, passes: Span } {
  if rule.above {
    { fails: { hi: Int.min(span.hi, rule.value), lo: span.lo }, passes: { hi: span.hi, lo: Int.max(span.lo, rule.value + 1) } }
  } else {
    { fails: { hi: span.hi, lo: Int.max(span.lo, rule.value) }, passes: { hi: Int.min(span.hi, rule.value - 1), lo: span.lo } }
  }
}

/// Walks the remaining rules of one workflow, carrying the box that has failed
/// every rule so far. Nothing is left over at the end: the last rule is
/// unconditional, so the carried box always finds a destination.
fn through(workflows: Map[Str, List[Rule]], rules: List[Rule], box: Map[Str, Span]) -> Result[Int, Str] {
  match rules.first() {
    None => Ok(0)
    Some(rule) => {
      if rule.field == "" {
        accepted(workflows, rule.dest, box)
      } else {
        let { fails:, passes: } = split(Map.get_or(box, rule.field, { hi: 0, lo: 1 }), rule)
        Ok(try accepted(workflows, rule.dest, Map.insert(box, rule.field, passes))
          + try through(workflows, rules.drop(1), Map.insert(box, rule.field, fails)))
      }
    }
  }
}

fn accepted(workflows: Map[Str, List[Rule]], name: Str, box: Map[Str, Span]) -> Result[Int, Str] {
  let total = combinations(box)
  if total == 0 or name == "R" {
    Ok(0)
  } else if name == "A" {
    Ok(total)
  } else {
    through(workflows, try Map.get(workflows, name).ok_or("no such workflow: " ++ name), box)
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let blocks = (try Fs.read_text(sys.fs.read, path)).trim().split("\n\n")
  let lines = (try blocks.get(0).ok_or("no workflows")).split("\n").reject(fn(line) { line.trim() == "" })
  let parsed = try lines.try_map(parse_workflow)
  let workflows = parsed.fold(Map.empty(), fn(found, entry) { Map.insert(found, entry.name, entry.rules) })
  let everything = Map.from_list(["x", "m", "a", "s"].map(fn(field) { { key: field, value: { hi: 4000, lo: 1 } } }))
  sys.console.print("workflows: " ++ Int.to_str(parsed.len()))
  sys.console.print("accepted combinations: " ++ Int.to_str(try accepted(workflows, "in", everything)))
  Ok(())
}
