/// Parts rated `x`, `m`, `a`, `s` are fed through named workflows until one
/// accepts or rejects them. Sum every rating of every accepted part: 19114 on
/// `sample.txt`.
///
/// Advent of Code 2023, day 19, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

/// A rule with an empty `field` is the workflow's unconditional last resort.
type Rule = { dest: Str, field: Str, above: Bool, value: Int }

fn parse_rule(text: Str) -> Result[Rule, Str] {
  let halves = text.split(":")
  if halves.len() == 1 {
    Ok({ dest: text, field: "", above: false, value: 0 })
  } else {
    let bad = "expected `<test>:<dest>`, got: " ++ text
    let test = halves.get(0).ok_or(bad)?
    let above = test.contains(">")
    let sides = test.split(if above { ">" } else { "<" })
    let malformed = "expected `<field><op><value>`, got: " ++ test
    Ok({
      dest: halves.get(1).ok_or(bad)?,
      field: sides.get(0).ok_or(malformed)?,
      above:,
      value: Int.parse(sides.get(1).ok_or(malformed)?)?,
    })
  }
}

fn parse_workflow(line: Str) -> Result[{ name: Str, rules: List[Rule] }, Str] {
  let bad = "expected `<name>{<rules>}`, got: " ++ line
  let halves = line.strip_suffix("}").ok_or(bad)?.split("{")
  Ok({
    name: halves.get(0).ok_or(bad)?,
    rules: halves.get(1).ok_or(bad)?.split(",").try_map(parse_rule)?,
  })
}

fn parse_rating(text: Str) -> Result[{ key: Str, value: Int }, Str] {
  let halves = text.split("=")
  let bad = "expected `<field>=<value>`, got: " ++ text
  Ok({ key: halves.get(0).ok_or(bad)?, value: Int.parse(halves.get(1).ok_or(bad)?)? })
}

/// A part is its four ratings keyed by field name. A record would need the four
/// cases spelled out to look up the field a rule tests, since a record cannot be
/// indexed by a string; a map is indexed by exactly the letter the input names.
fn parse_part(line: Str) -> Result[Map[Str, Int], Str] {
  let bad = "expected `{<field>=<value>,...}`, got: " ++ line
  let body = line.strip_prefix("{").ok_or(bad)?.strip_suffix("}").ok_or(bad)?
  Ok(Map.from_list(body.split(",").try_map(parse_rating)?))
}

fn matches(rule: Rule, part: Map[Str, Int]) -> Bool {
  if rule.field == "" {
    true
  } else if rule.above {
    Map.get_or(part, rule.field, 0) > rule.value
  } else {
    Map.get_or(part, rule.field, 0) < rule.value
  }
}

/// Follows the part from workflow to workflow. Every workflow ends in an
/// unconditional rule, so some rule always matches.
fn sort_part(workflows: Map[Str, List[Rule]], name: Str, part: Map[Str, Int]) -> Result[Bool, Str] {
  if name == "A" {
    Ok(true)
  } else if name == "R" {
    Ok(false)
  } else {
    let rules = Map.get(workflows, name).ok_or("no such workflow: " ++ name)?
    let { dest: } = List.find(rules, fn(rule) { matches(rule, part) }).ok_or("no rule matched in: " ++ name)?
    sort_part(workflows, dest, part)
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let blocks = Fs.read_text(sys.fs.read, path)?.trim().split("\n\n")
  let lines = blocks.get(0).ok_or("no workflows")?.split("\n").reject(fn(line) { line.trim() == "" })
  let parsed = lines.try_map(parse_workflow)?
  let workflows = parsed.fold(Map.empty(), fn(found, entry) { Map.insert(found, entry.name, entry.rules) })
  let parts = blocks.get(1).ok_or("no parts")?.split("\n").reject(fn(line) { line.trim() == "" }).try_map(parse_part)?
  let accepted = parts.try_map(fn(part) {
    sort_part(workflows, "in", part).map(fn(taken) { if taken { Map.values(part).sum() } else { 0 } })
  })?
  sys.console.print("parts: " ++ Int.to_str(parts.len()) ++ ", workflows: " ++ Int.to_str(parsed.len()))
  sys.console.print("sum of accepted ratings: " ++ Int.to_str(accepted.sum()))
  Ok(())
}
