/// The records were folded: each row is really five copies of itself joined by
/// `?`, with the group list repeated five times to match. `sample.txt` grows from
/// 21 arrangements to 525152, and one of its rows alone goes from 10 to 506250.
///
/// Nothing about the method changes — which is the point of having counted rather
/// than enumerated in part 1. A row unfolds to about a hundred springs and thirty
/// groups, so the arrangements run into the billions while the table stays around
/// three thousand cells.
///
/// `f(i, j)` is the number of ways the record from `i` onward can hold the groups
/// from `j` onward, and it splits on what sits at `i`:
/// treat it as operational and move to `f(i + 1, j)`, or start group `j` here and
/// jump past it and its separator to `f(i + group + 1, j + 1)`. A `?` allows both,
/// a `.` only the first, a `#` only the second.
///
/// Sigil has no mutable memo table, so the table is built bottom-up instead: rows
/// go from `i = n` down to 0, and each row reads only the rows below it, which are
/// already in the list being folded through. That gets memoisation's asymptotics
/// with no mutation and no recursion.
///
/// Advent of Code 2023, day 12, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Record = { groups: List[Int], springs: List[Str] }

fn parse_record(line: Str) -> Result[Record, Str] {
  let parts = line.words()
  let springs = parts.get(0).ok_or("expected `<springs> <groups>`, got: " ++ line)?
  let groups = parts.get(1).ok_or("expected `<springs> <groups>`, got: " ++ line)?
  let five = List.range(0, 5)
  Ok({
    groups: five.flat_map(fn(copy) { groups.split(",") }).try_map(Int.parse)?,
    springs: five.map(fn(copy) { springs }).join("?").chars(),
  })
}

/// How long a group could be if it started at each index: the run of springs from
/// there that are not known-operational. Built once per record from the right, so
/// checking whether group `size` fits at `i` is a comparison rather than a scan.
fn damaged_runs(springs: List[Str]) -> List[Int] {
  List.range(0, springs.len()).fold([], fn(runs, step) {
    let i = springs.len() - 1 - step
    if springs.get(i).unwrap_or(".") == "." {
      [0] ++ runs
    } else {
      [1 + runs.first().unwrap_or(0)] ++ runs
    }
  })
}

/// Rows are kept with the most recently built at the head, so while row `i` is
/// being filled the head is row `i + 1` and row `i + d` sits at index `d - 1`.
/// Indexing a list beats hashing a packed key into a `Map`: on the real input that
/// alone is the difference between half a minute and a few seconds.
///
/// Row `n` is the base case: having consumed the whole record, there is one
/// arrangement if every group was placed and none otherwise.
fn arrangements(record: Record) -> Int {
  let { springs:, groups: } = record
  let n = springs.len()
  let m = groups.len()
  let runs = damaged_runs(springs)
  let columns = List.range(0, m + 1)
  let base = [columns.map(fn(j) { if j == m { 1 } else { 0 } })]
  let filled = List.range(0, n).fold(base, fn(rows, step) {
    let i = n - 1 - step
    let here = springs.get(i).unwrap_or(".")
    let run = runs.get(i).unwrap_or(0)
    let below = rows.first().unwrap_or([])
    [columns.map(fn(j) {
      let as_operational = if here == "#" { 0 } else { below.get(j).unwrap_or(0) }
      let as_damaged = if here == "." or j >= m {
        0
      } else {
        // A group of `size` fits when it stays inside the run and is not butted
        // against a `#`, which would make it longer than claimed. It lands on row
        // `i + size + 1`, past the group and its separator, except when it ends
        // the record exactly and there is no separator left to skip.
        let size = groups.get(j).unwrap_or(0)
        if size <= run and (i + size == n or springs.get(i + size).unwrap_or(".") != "#") {
          rows.get(Int.min(size, n - i - 1)).and_then(fn(row) { row.get(j + 1) }).unwrap_or(0)
        } else {
          0
        }
      }
      as_operational + as_damaged
    })] ++ rows
  })
  filled.first().and_then(fn(row) { row.first() }).unwrap_or(0)
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let records = Fs.read_lines(sys.fs.read, path)?.reject(fn(line) { line.trim() == "" }).try_map(parse_record)?
  sys.console.print("sum of arrangements: " ++ Int.to_str(records.map(arrangements).sum()))
  Ok(())
}
