/// The same histories, extrapolated backwards. Sum the values that came before:
/// -3 + 0 + 5 = 2 on `sample.txt`.
///
/// Only two things change from part 1. The row's *first* value is the one to
/// build on, and the difference row is *subtracted* from it rather than added —
/// because the row below is what was added going forward, so going backward it
/// comes off. Reversing each history and reusing part 1 would work too; naming
/// the subtraction says why it works rather than hiding it behind a reversal.
///
/// Advent of Code 2023, day 9, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

fn parse_history(line: Str) -> Result[List[Int], Str] {
  line.words().try_map(Int.parse)
}

fn differences(values: List[Int]) -> List[Int] {
  values.windows(2).map(fn(pair) { pair.get(1).unwrap_or(0) - pair.get(0).unwrap_or(0) })
}

fn extrapolate_back(values: List[Int]) -> Int {
  if values.all(fn(value) { value == 0 }) {
    0
  } else {
    values.first().unwrap_or(0) - extrapolate_back(differences(values))
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let histories = Fs.read_lines(sys.fs.read, path)?.reject(fn(line) { line.trim() == "" }).try_map(parse_history)?
  sys.console.print("sum of previous values: " ++ Int.to_str(histories.map(extrapolate_back).sum()))
  Ok(())
}
