/// Each line is a history. Take differences until they are all zero, then walk
/// back up adding the last value of each row to the one above. Sum the predicted
/// next values: 18 + 28 + 68 = 114 on `sample.txt`.
///
/// The recursion does the walking back up on its own — a row's next value is its
/// own last value plus the next value of its difference row, and the all-zero row
/// contributes nothing. There is no pyramid to build and no bottom-up pass to
/// write; the call stack is the pyramid.
///
/// Advent of Code 2023, day 9, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

fn parse_history(line: Str) -> Result[List[Int], Str] {
  line.words().try_map(Int.parse)
}

/// One row of differences: each neighbouring pair, later minus earlier.
fn differences(values: List[Int]) -> List[Int] {
  values.windows(2).map(fn(pair) { pair.get(1).unwrap_or(0) - pair.get(0).unwrap_or(0) })
}

/// A row of all zeroes extrapolates to zero, which is what stops the recursion —
/// and differencing shortens the row every time, so it always arrives.
fn predict(values: List[Int]) -> Int {
  if values.all(fn(value) { value == 0 }) {
    0
  } else {
    values.last().unwrap_or(0) + predict(differences(values))
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let histories = Fs.read_lines(sys.fs.read, path)?.reject(fn(line) { line.trim() == "" }).try_map(parse_history)?
  sys.console.print("sum of next values: " ++ Int.to_str(histories.map(predict).sum()))
  Ok(())
}
