/// The beam may enter from any edge tile, heading inward. Find the entry that
/// lights the most tiles: 51 on `sample.txt`, from the fourth tile of the top row
/// heading down — more than the 46 part 1's top-left entry manages.
///
/// Every edge entry is simply tried; there are only about four hundred, and each
/// one is a fresh walk. Nothing carries over between them, because a state's
/// reachable set depends on where the beam came from.
///
/// Splitters make the beam a set of beams, and mirrors make it loop, so the search
/// is over `(tile, direction)` states rather than tiles. Only a mirror or splitter
/// can branch a beam or turn it, though, so only those states are worth naming:
/// empty space is slid through in one go, lighting the tiles it passes. A mirror
/// state already visited produces exactly what it produced last time, so revisiting
/// it can be dropped — that is what stops the loops, and since a loop has to turn
/// somewhere to close, it is enough. The answer counts distinct *tiles*, since one
/// tile lit from two directions is still one tile.
///
/// Directions are numbered north, east, south, west, which makes both mirrors
/// arithmetic: `/` swaps each direction with its neighbour in the cycle, and `\`
/// reflects the numbering about its middle. Naming the four cases twice would be
/// no clearer than saying it once.
///
/// Advent of Code 2023, day 16, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

/// `d` is 0 north, 1 east, 2 south, 3 west — the compass, clockwise.
type Beam = { c: Int, d: Int, r: Int }

/// The rows with their extent alongside. Carrying the width rather than asking
/// the first row for its length each time matters: `inside` runs once per tile
/// slid over, and a `List.first` plus a `Str.len` inside it is most of the work.
type Grid = { height: Int, rows: List[Str], width: Int }

fn Grid.of(rows: List[Str]) -> Grid {
  { height: rows.len(), rows:, width: rows.first().unwrap_or("").len() }
}

fn tile(grid: Grid, beam: Beam) -> Str {
  match grid.rows.get(beam.r) {
    None => "."
    Some(row) => row.slice(beam.c, beam.c + 1)
  }
}

fn inside(grid: Grid, beam: Beam) -> Bool {
  beam.r >= 0 and beam.r < grid.height and beam.c >= 0 and beam.c < grid.width
}

/// North and south are even, east and west odd, so `/` pairs 0 with 1 and 2 with
/// 3 — swap each direction with its partner.
fn bounce_slash(d: Int) -> Int {
  if d % 2 == 0 { d + 1 } else { d - 1 }
}

/// `\` pairs north with west and east with south, which is the numbering read
/// backwards.
fn bounce_backslash(d: Int) -> Int {
  3 - d
}

/// Which way the beam leaves this tile. A splitter hit end-on is empty space; hit
/// side-on it becomes two beams.
fn onward(square: Str, d: Int) -> List[Int] {
  if square == "/" {
    [bounce_slash(d)]
  } else if square == "\\" {
    [bounce_backslash(d)]
  } else if square == "|" and d % 2 == 1 {
    [0, 2]
  } else if square == "-" and d % 2 == 0 {
    [1, 3]
  } else {
    [d]
  }
}

fn advance(beam: Beam, d: Int) -> Beam {
  if d == 0 {
    { c: beam.c, d:, r: beam.r - 1 }
  } else if d == 1 {
    { c: beam.c + 1, d:, r: beam.r }
  } else if d == 2 {
    { c: beam.c, d:, r: beam.r + 1 }
  } else {
    { c: beam.c - 1, d:, r: beam.r }
  }
}

/// A row of flags, one per position, all false.
fn flags(width: Int) -> List[Bool] {
  List.range(0, width).map(fn(at) { false })
}

/// Both sets below are a list of rows rather than a map of anything, and that is
/// the whole difference between this version and the one that was written before
/// `List.put` existed. Every position is known in advance — the grid is a
/// rectangle — so the position *is* the key, and nothing has to be allocated,
/// hashed or compared to reach it. The earlier version keyed a `Map` by row and
/// each row by a packed column, because a map of small maps was the only way to
/// stop `Map.insert` copying the whole grid on every write, and this part's 440
/// starts made that the difference between tractable and not.
fn flag_grid(height: Int, width: Int) -> List[List[Bool]] {
  List.range(0, height).map(fn(at) { flags(width) })
}

fn flag_at(grid: List[List[Bool]], r: Int, at: Int) -> Bool {
  grid.get(r).unwrap_or([]).get(at).unwrap_or(false)
}

fn flag_set(grid: List[List[Bool]], r: Int, at: Int) -> List[List[Bool]] {
  grid.update(r, fn(row) { row.put(at, true) })
}

/// Where a beam sits within its row: column and heading packed together, so one
/// row of the `seen` grid is four flags per column.
fn mark(beam: Beam) -> Int {
  beam.c * 4 + beam.d
}

fn seen_has(seen: List[List[Bool]], beam: Beam) -> Bool {
  flag_at(seen, beam.r, mark(beam))
}

fn seen_add(seen: List[List[Bool]], beam: Beam) -> List[List[Bool]] {
  flag_set(seen, beam.r, mark(beam))
}

/// Lit tiles need no heading, so these are flagged by column alone. Re-lighting a
/// tile writes the flag that is already there, which is what it costs to say.
fn light(lit: List[List[Bool]], beam: Beam) -> List[List[Bool]] {
  flag_set(lit, beam.r, beam.c)
}

/// How far one straight run got: the tiles it lit, and the mirror or splitter it
/// stopped on, if it stopped rather than left the grid.
type Step = { lit: List[List[Bool]], stop: Option[Beam] }

/// Empty space cannot turn a beam, so a run of `.` is one slide rather than one
/// step per tile.
fn slide(grid: Grid, beam: Beam, lit: List[List[Bool]]) -> Step {
  if not inside(grid, beam) {
    { lit:, stop: None }
  } else {
    let marked = light(lit, beam)
    if tile(grid, beam) == "." {
      slide(grid, advance(beam, beam.d), marked)
    } else {
      { lit: marked, stop: Some(beam) }
    }
  }
}

/// Takes one mirror off the stack, slides away along each way out, and pushes
/// whatever mirrors those runs land on. A state is marked as it is pushed, so it
/// is never pushed twice and the stack drains once every reachable mirror has
/// been reached — which it must, there being finitely many.
fn trace(
  grid: Grid,
  stack: List[Beam],
  seen: List[List[Bool]],
  lit: List[List[Bool]],
) -> List[List[Bool]] {
  match stack.first() {
    None => lit
    Some(beam) => {
      let { lit:, seen:, stack: } = onward(tile(grid, beam), beam.d).fold(
        { lit:, seen:, stack: stack.drop(1) },
        fn(acc, d) {
          let { lit:, stop: } = slide(grid, advance(beam, d), acc.lit)
          match stop {
            None => { lit:, seen: acc.seen, stack: acc.stack }
            Some(hit) => {
              if seen_has(acc.seen, hit) {
                { lit:, seen: acc.seen, stack: acc.stack }
              } else {
                { lit:, seen: seen_add(acc.seen, hit), stack: acc.stack.push(hit) }
              }
            }
          }
        },
      )
      trace(grid, stack, seen, lit)
    }
  }
}

/// The walk starts with a slide, since the entry tile need not be a mirror; if
/// that slide leaves the grid there is nothing to trace.
///
/// The two empty grids are passed in rather than built here, and that is not a
/// micro-optimisation: this runs 440 times, and a grid built inside it is a grid
/// built 440 times. An empty grid is a *value* — nothing writes to it, `put`
/// returns a new one — so one of each serves every start, which is the property
/// that makes the dense representation affordable at all. Building them per call
/// costs 2.7× the whole program.
fn energised(grid: Grid, start: Beam, blank_lit: List[List[Bool]], blank_seen: List[List[Bool]]) -> Int {
  let { lit:, stop: } = slide(grid, start, blank_lit)
  let lit = match stop {
    None => lit
    Some(hit) => trace(grid, [hit], seen_add(blank_seen, hit), lit)
  }
  lit.map(fn(row) { row.count(fn(flag) { flag }) }).sum()
}

/// Every way in: down the left edge heading east, down the right edge heading
/// west, along the top heading south, along the bottom heading north.
fn entries(grid: Grid) -> List[Beam] {
  List.range(0, grid.height).flat_map(fn(r) {
    [{ c: 0, d: 1, r: }, { c: grid.width - 1, d: 3, r: }]
  }) ++ List.range(0, grid.width).flat_map(fn(c) {
    [{ c:, d: 2, r: 0 }, { c:, d: 0, r: grid.height - 1 }]
  })
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let grid = Grid.of(Fs.read_lines(sys.fs.read, path)?.reject(fn(line) { line == "" }))
  let starts = entries(grid)
  let blank_lit = flag_grid(grid.height, grid.width)
  let blank_seen = flag_grid(grid.height, grid.width * 4)
  let best = starts.map(fn(start) { energised(grid, start, blank_lit, blank_seen) }).max()
  sys.console.print("entries tried: " ++ Int.to_str(starts.len()))
  sys.console.print("best energised tiles: " ++ Int.to_str(best.ok_or("no entry points")?))
  Ok(())
}
