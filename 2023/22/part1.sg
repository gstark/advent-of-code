/// Bricks are snapshotted mid-fall; let them settle, then count how many could be
/// disintegrated without anything else moving. 5 of the 7 on `sample.txt` — only
/// `A`, the sole support of two bricks, and `F`, the sole support of `G`, are
/// unsafe.
///
/// Settling needs no simulation of falling. Taking the bricks in order of height,
/// every brick beneath a given one has already landed, so its resting height is
/// simply one above the tallest column its footprint covers. One small map tracks
/// that: for each `(x, y)` column, its current top height and the brick sitting
/// there.
///
/// A brick is unsafe exactly when something above it rests on it *alone*, so the
/// supports are collected while settling and the unsafe bricks read straight off:
/// every brick with exactly one supporter condemns that supporter. Nothing is ever
/// removed and re-dropped.
///
/// Advent of Code 2023, day 22, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

/// A brick as given, with `lo` and `hi` ordered on every axis.
type Brick = { hx: Int, hy: Int, hz: Int, lx: Int, ly: Int, lz: Int }

/// One `(x, y)` column of the stack, keying the map below.
type Cell = { x: Int, y: Int }

/// The topmost brick on a column, and the height it reaches.
type Column = { top: Int, brick: Int }

/// The columns as bricks land on them, and each brick's supporters by index.
type Stack = { supports: List[List[Int]], columns: Map[Cell, Column] }

fn parse_end(text: Str) -> Result[List[Int], Str] {
  let parts = text.trim().split(",").try_map(Int.parse)?
  if parts.len() != 3 {
    Err("expected `x,y,z`, got: " ++ text)
  } else {
    Ok(parts)
  }
}

fn parse_brick(line: Str) -> Result[Brick, Str] {
  let ends = line.split("~")
  let malformed = "expected `<end>~<end>`, got: " ++ line
  let a = parse_end(ends.get(0).ok_or(malformed)?)?
  let b = parse_end(ends.get(1).ok_or(malformed)?)?
  let axes = a.zip(b)
  let hi = axes.map(fn(axis) { Int.max(axis.first, axis.second) })
  let lo = axes.map(fn(axis) { Int.min(axis.first, axis.second) })
  Ok({
    hx: hi.get(0).unwrap_or(0),
    hy: hi.get(1).unwrap_or(0),
    hz: hi.get(2).unwrap_or(0),
    lx: lo.get(0).unwrap_or(0),
    ly: lo.get(1).unwrap_or(0),
    lz: lo.get(2).unwrap_or(0),
  })
}

/// The `(x, y)` columns a brick stands on.
fn footprint(brick: Brick) -> List[Cell] {
  List.range(brick.lx, brick.hx + 1).flat_map(fn(x) {
    List.range(brick.ly, brick.hy + 1).map(fn(y) { { x:, y: } })
  })
}

/// Lands one brick on the stack so far, recording what it came to rest on. The
/// bricks already placed are numbered as they were settled, so the next index is
/// however many supports have been recorded.
fn settle(stack: Stack, brick: Brick) -> Stack {
  let cells = footprint(brick)
  let under = cells.flat_map(fn(cell) { Option.to_list(Map.get(stack.columns, cell)) })
  // Every occupied column reaches at least height 1, so an empty `under` — a brick
  // landing on the floor — falls out as a base of 0 with nothing resting beneath.
  let base = under.map(fn(column) { column.top }).max().unwrap_or(0)
  let resting = under.filter(fn(column) { column.top == base }).map(fn(column) { column.brick }).uniq()
  let landed = { top: base + 1 + brick.hz - brick.lz, brick: stack.supports.len() }
  {
    supports: stack.supports.push(resting),
    columns: cells.fold(stack.columns, fn(columns, cell) { Map.insert(columns, cell, landed) }),
  }
}

/// Bricks settle from the bottom up, so the snapshot is sorted by its lower `z`
/// first — that is what makes one pass enough.
fn settle_all(bricks: List[Brick]) -> Stack {
  bricks
    .sort_by(fn(brick) { brick.lz })
    .fold({ supports: [], columns: Map.empty() }, fn(stack, brick) { settle(stack, brick) })
}

/// A brick resting on exactly one other makes that one unsafe to remove.
fn load_bearing(supports: List[List[Int]]) -> List[Int] {
  supports.filter(fn(resting) { resting.len() == 1 }).flat_map(fn(resting) { resting }).uniq()
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let bricks = Fs.read_lines(sys.fs.read, path)?.reject(fn(line) { line.trim() == "" }).try_map(parse_brick)?
  let condemned = load_bearing(settle_all(bricks).supports)
  sys.console.print("bricks: " ++ Int.to_str(bricks.len()) ++ ", load-bearing: " ++ Int.to_str(condemned.len()))
  sys.console.print("safe to disintegrate: " ++ Int.to_str(bricks.len() - condemned.len()))
  Ok(())
}
