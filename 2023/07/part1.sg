/// Rank the hands weakest to strongest, then sum each hand's bid times its rank:
/// 765 * 1 + 220 * 2 + 28 * 3 + 684 * 4 + 483 * 5 = 6440 on `sample.txt`.
///
/// Ordering is by hand type first, then card by card left to right. Both are
/// encoded into one sortable string: two leading letters for the type, then one
/// letter per card in strength order. `2` becomes `a`, `A` becomes `m`, so
/// alphabetical order on the key *is* the puzzle's order, and the whole ranking
/// is a single `sort_by` — no comparator that has to remember two rules at once.
///
/// Advent of Code 2023, day 7, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type FsErr =
  | Denied(path: Str)
  | NotFound(path: Str)

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Hand = { bid: Int, key: Str }

fn fs_message(error: FsErr) -> Str {
  match error {
    Denied(path) => "denied " ++ path
    NotFound(path) => "not found " ++ path
  }
}

fn read_lines(fs: Fs, path: Str) -> Result[List[Str], Str] {
  match fs.read(path) {
    Err(error) => Err("could not read " ++ path ++ ": " ++ fs_message(error))
    Ok(text) => Ok(text.trim().split("\n").reject(fn(line) { line == "" }))
  }
}

/// Strength as a letter, low to high. Thirteen cards and seven hand types both
/// fit inside `a` through `m`.
fn letter(index: Int) -> Str {
  "abcdefghijklm".slice(index, index + 1)
}

fn card_rank(card: Str) -> Int {
  Str.index_of("23456789TJQKA", card).unwrap_or(0)
}

/// The largest group and the number of distinct labels separate all seven types
/// between them — a full house and a three of a kind share a largest group of
/// three and differ only in how many labels are left over. Better still, ranking
/// by largest group and then by *fewest* labels reproduces the type order exactly,
/// so the seven types need no names: two letters carry them.
fn type_key(cards: Str) -> Str {
  let counts = Map.values(cards.chars().tally())
  letter(counts.max().unwrap_or(0)) ++ letter(5 - counts.len())
}

fn sort_key(cards: Str) -> Str {
  type_key(cards) ++ cards.chars().map(fn(card) { letter(card_rank(card)) }).join("")
}

fn parse_hand(line: Str) -> Result[Hand, Str] {
  let parts = line.words()
  let malformed = "expected `<cards> <bid>`, got: " ++ line
  let cards = parts.get(0).ok_or(malformed)?
  let bid = parts.get(1).ok_or(malformed)?
  Ok({ bid: Int.parse(bid)?, key: sort_key(cards) })
}

fn winnings(hands: List[Hand]) -> Int {
  let ranked = hands.sort_by(fn(hand) { hand.key })
  List.range(1, ranked.len() + 1).zip(ranked).map(fn(pair) {
    pair.first * pair.second.bid
  }).sum()
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let hands = read_lines(sys.fs, path)?.try_map(parse_hand)?
  sys.console.print("total winnings: " ++ Int.to_str(winnings(hands)))
  Ok(())
}
