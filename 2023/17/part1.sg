/// Steer a crucible from the top-left block to the bottom-right, paying each
/// block's digit as it is entered, never running more than three blocks straight
/// and never reversing. Least heat loss: 102 on `sample.txt`.
///
/// The "at most three straight" rule is not carried in the state. A state here is
/// just a block plus which *axis* the crucible last travelled along, because the
/// only thing the next move needs to know is that it must be perpendicular. A move
/// is then a whole run of one to three blocks in one direction, charged for every
/// block it crosses. That collapses the search to `width * height * 2` states —
/// about forty thousand — instead of tracking a run length per state, and the
/// no-reversing rule enforces itself, since a perpendicular turn cannot reverse.
///
/// Dijkstra on the library's `Heap` (issue #26 closed what this program was the
/// evidence for). The first version had no heap to reach for and hand-rolled a
/// bucket queue — a `Map` from distance to the states waiting at it, correct
/// only because every edge weight is a small integer. The frontier is now a
/// `Heap[Step]` ordered by cost, which is the general structure; the distance
/// table stays a `List` written through `List.put`, so a state's position
/// reaches its cell directly (keying a flat `Map` by the state measured 13x
/// slower before that change).
///
/// Advent of Code 2023, day 17, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Grid = { cells: List[List[Int]], height: Int, width: Int }

/// `axis` is 0 when the last run was vertical and 1 when it was horizontal; the
/// next run must be the other one.
type State = { axis: Int, c: Int, r: Int }

type Step = { cost: Int, state: State }

/// The frontier as a min-heap of costed states, alongside the best distance
/// known for each state.
type Search = { best: List[List[Option[Int]]], frontier: Heap[Step] }

/// The order the frontier pops in: cheapest first, as `Heap.push` is told at
/// every call (D-019 — the comparison is a choice, so it travels).
fn by_cost(a: Step, b: Step) -> Int {
  Int.compare(a.cost, b.cost)
}

/// How few and how many blocks one run may cross.
const SHORTEST: Int = 1
const LONGEST: Int = 3

/// Digits are parsed once into a table. Re-slicing and re-parsing the text on
/// every block read is the kind of cost that hides well and dominates completely.
fn Grid.of(rows: List[Str]) -> Result[Grid, Str] {
  let cells = try rows.try_map(fn(row) { row.chars().try_map(Int.parse) })
  Ok({ cells:, height: rows.len(), width: rows.first().unwrap_or("").len() })
}

fn slot(state: State) -> Int {
  state.c * 2 + state.axis
}

/// One cell per state, and every state is known in advance: a block, and which
/// axis the run that reached it was on. That is what `List.put` buys — the
/// position is the key, so nothing is allocated or compared to reach a cell.
/// Before it existed this was a `Map` of small `Map`s bucketed by row, because a
/// flat `Map` grew until its insert cost dominated.
fn blank(grid: Grid) -> List[List[Option[Int]]] {
  List.range(0, grid.height).map(fn(at) {
    List.range(0, grid.width * 2).map(fn(c) { None })
  })
}

fn best_of(best: List[List[Option[Int]]], state: State) -> Option[Int] {
  best.get(state.r).unwrap_or([]).get(slot(state)).unwrap_or(None)
}

fn set_best(best: List[List[Option[Int]]], state: State, cost: Int) -> List[List[Option[Int]]] {
  best.update(state.r, fn(row) { row.put(slot(state), Some(cost)) })
}

fn heat(grid: Grid, r: Int, c: Int) -> Int {
  grid.cells.get(r).and_then(fn(row) { row.get(c) }).unwrap_or(0)
}

fn inside(grid: Grid, r: Int, c: Int) -> Bool {
  r >= 0 and r < grid.height and c >= 0 and c < grid.width
}

/// One straight run away from `from`, gathering a move for every legal length.
/// Heat accumulates block by block, so a four-block run pays for all four.
fn ray(grid: Grid, from: State, dr: Int, dc: Int, axis: Int, k: Int, paid: Int, found: List[Step]) -> List[Step] {
  if k > LONGEST {
    found
  } else {
    let nr = from.r + dr * k
    let nc = from.c + dc * k
    if not inside(grid, nr, nc) {
      found
    } else {
      let running = paid + heat(grid, nr, nc)
      let gathered = if k >= SHORTEST {
        found.push({ cost: running, state: { axis:, c: nc, r: nr } })
      } else {
        found
      }
      ray(grid, from, dr, dc, axis, k + 1, running, gathered)
    }
  }
}

/// Both runs perpendicular to the state's axis, in both directions. The turned-to
/// axis doubles as the step, since axis 1 is horizontal and so moves by a column
/// while axis 0 moves by a row.
fn moves(grid: Grid, state: State) -> List[Step] {
  let turned = 1 - state.axis
  ray(grid, state, state.axis, turned, turned, 1, 0, [])
    ++ ray(grid, state, 0 - state.axis, 0 - turned, turned, 1, 0, [])
}

fn offer(search: Search, step: Step, at: Int) -> Search {
  let reached = at + step.cost
  if best_of(search.best, step.state).map(fn(seen) { seen <= reached }).unwrap_or(false) {
    search
  } else {
    {
      best: set_best(search.best, step.state, reached),
      frontier: search.frontier.push({ cost: reached, state: step.state }, by_cost),
    }
  }
}

/// A state can be queued more than once and only the first pop is authoritative;
/// the rest are stale and skipped by comparing against the recorded best. The
/// heap pops costs in increasing order, so the first time the bottom-right
/// block comes up, its cost is the answer.
fn run(grid: Grid, search: Search) -> Result[Int, Str] {
  match Heap.pop(search.frontier, by_cost) {
    None => Err("no route to the factory")
    Some(popped) => {
      let step = popped.top
      let rest = { best: search.best, frontier: popped.rest }
      if best_of(search.best, step.state).unwrap_or(0 - 1) != step.cost {
        run(grid, rest)
      } else if step.state.r == grid.height - 1 and step.state.c == grid.width - 1 {
        Ok(step.cost)
      } else {
        run(grid, moves(grid, step.state).fold(rest, fn(inner, move) { offer(inner, move, step.cost) }))
      }
    }
  }
}

fn least_heat(grid: Grid) -> Result[Int, Str] {
  let starts = [{ axis: 0, c: 0, r: 0 }, { axis: 1, c: 0, r: 0 }]
  let search = {
    best: starts.fold(blank(grid), fn(best, state) { set_best(best, state, 0) }),
    frontier: starts.fold(Heap.empty(), fn(heap, state) { heap.push({ cost: 0, state: state }, by_cost) }),
  }
  run(grid, search)
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let grid = try Grid.of((try Fs.read_lines(sys.fs.read, path)).reject(fn(line) { line == "" }))
  sys.console.print("least heat loss: " ++ Int.to_str(try least_heat(grid)))
  Ok(())
}
