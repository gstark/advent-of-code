/// How many garden plots are reachable in exactly 64 steps from `S`, stepping
/// only onto plots. 16 in 6 steps on `sample.txt` — the step count is a second
/// argument, since the sample and the real input want different ones.
///
/// "Exactly `n` steps" is not the same as "within `n` steps", but it nearly is:
/// a plot reachable in `k` steps is reachable in `k + 2` as well, by stepping off
/// and back. So every plot whose distance is at most `n` and has the same parity
/// as `n` is reachable in exactly `n`, and no other is. One breadth-first sweep
/// counting by parity answers it — there is no need to track which plots are
/// occupied at each step.
///
/// Advent of Code 2023, day 21, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt 64`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Plot = { c: Int, r: Int }

type Grid = { height: Int, rows: List[Str], width: Int }

fn Grid.of(rows: List[Str]) -> Grid {
  { height: rows.len(), rows:, width: rows.first().unwrap_or("").len() }
}

fn tile(grid: Grid, at: Plot) -> Str {
  match grid.rows.get(at.r) {
    None => "#"
    Some(row) => if at.c < 0 or at.c >= row.len() { "#" } else { row.slice(at.c, at.c + 1) }
  }
}

fn start_of(grid: Grid) -> Result[Plot, Str] {
  List.range(0, grid.height).flat_map(fn(r) {
    match Str.index_of(grid.rows.get(r).unwrap_or(""), "S") {
      None => []
      Some(c) => [{ c:, r: }]
    }
  }).first().ok_or("no starting position")
}

fn neighbours(at: Plot) -> List[Plot] {
  [
    { c: at.c, r: at.r - 1 },
    { c: at.c, r: at.r + 1 },
    { c: at.c + 1, r: at.r },
    { c: at.c - 1, r: at.r },
  ]
}

/// Visited plots are a flag per plot, in a grid the same shape as the map.
///
/// This used to be a map of small maps bucketed by row, because a flat `Map`
/// grew until its insert cost dominated and there was no way to write one
/// element of a `List`. `List.put` is that way, and the position is the key:
/// nothing is allocated, hashed or compared to reach a plot. Off-map plots
/// cannot reach here — `tile` answers `#` for them and `sweep` drops them
/// first.
fn blank(grid: Grid) -> List[List[Bool]] {
  List.range(0, grid.height).map(fn(at) { List.range(0, grid.width).map(fn(c) { false }) })
}

fn seen_at(seen: List[List[Bool]], at: Plot) -> Bool {
  seen.get(at.r).unwrap_or([]).get(at.c).unwrap_or(false)
}

fn mark(seen: List[List[Bool]], at: Plot) -> List[List[Bool]] {
  seen.update(at.r, fn(row) { row.put(at.c, true) })
}

/// Sweeps outward, counting the plots whose distance matches the target parity.
/// Marking each plot as it is accepted doubles as the deduplicator — two
/// neighbours of the frontier that land on the same plot cannot both pass, since
/// the first marks it. That avoids `List.uniq`, which is quadratic; see
/// `SIGIL-NOTES.md`.
fn sweep(grid: Grid, frontier: List[Plot], seen: List[List[Bool]], step: Int, steps: Int, reached: Int) -> Int {
  if step > steps or frontier.is_empty() {
    reached
  } else {
    let { fresh:, seen: } = frontier.flat_map(neighbours).fold({ fresh: [], seen: }, fn(state, at) {
      if tile(grid, at) == "#" or seen_at(state.seen, at) {
        state
      } else {
        { fresh: state.fresh.push(at), seen: mark(state.seen, at) }
      }
    })
    let counted = if (step + 1) % 2 == steps % 2 { reached + fresh.len() } else { reached }
    sweep(grid, fresh, seen, step + 1, steps, counted)
  }
}

fn reachable(grid: Grid, from: Plot, steps: Int) -> Int {
  let seeded = if steps % 2 == 0 { 1 } else { 0 }
  sweep(grid, [from], mark(blank(grid), from), 0, steps, seeded)
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let steps = match sys.args.get(1) {
    None => 64
    Some(raw) => try Int.parse(raw)
  }
  let grid = Grid.of((try Fs.read_lines(sys.fs.read, path)).reject(fn(line) { line == "" }))
  sys.console.print("plots reachable in exactly " ++ Int.to_str(steps) ++ " steps: "
    ++ Int.to_str(reachable(grid, try start_of(grid), steps)))
  Ok(())
}
