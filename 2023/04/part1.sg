/// Each scratchcard lists winning numbers, a `|`, then the numbers you hold. The
/// first match is worth a point and every match after that doubles it — so a card
/// with `n` matches scores `2^(n-1)`, and a card with none scores nothing. Summed
/// over `sample.txt`: 8 + 2 + 2 + 1 + 0 + 0 = 13.
///
/// Advent of Code 2023, day 4, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type FsErr =
  | Denied(path: Str)
  | NotFound(path: Str)

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

fn fs_message(error: FsErr) -> Str {
  match error {
    Denied(path) => "denied " ++ path
    NotFound(path) => "not found " ++ path
  }
}

fn read_lines(fs: Fs, path: Str) -> Result[List[Str], Str] {
  match fs.read(path) {
    Err(error) => Err("could not read " ++ path ++ ": " ++ fs_message(error))
    Ok(text) => Ok(text.trim().split("\n").reject(fn(line) { line == "" }))
  }
}

/// Numbers are column-aligned, so single digits arrive padded — `words` drops the
/// runs of spaces that `split(" ")` would turn into empty fields.
fn parse_numbers(text: Str) -> Result[List[Int], Str] {
  text.words().try_map(Int.parse)
}

/// How many of the held numbers are winners. The card's own id is not needed for
/// part 1 — the cards are scored where they lie. Rewriting the `:` as a `|` cuts
/// the line into its three fields in one split.
fn matches(line: Str) -> Result[Int, Str] {
  let fields = line.replace(":", "|").split("|")
  let malformed = "expected `Card <id>: <winning> | <held>`, got: " ++ line
  let winning = parse_numbers(fields.get(1).ok_or(malformed)?)?
  let held = parse_numbers(fields.get(2).ok_or(malformed)?)?
  Ok(held.count(fn(number) { winning.contains(number) }))
}

fn score(found: Int) -> Int {
  if found == 0 {
    0
  } else {
    Int.pow(2, found - 1)
  }
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let total = read_lines(sys.fs, path)?.try_map(matches)?.map(score).sum()
  sys.console.print("total points: " ++ Int.to_str(total))
  Ok(())
}
