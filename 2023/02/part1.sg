/// Each line records one game: an id, then semicolon-separated handfuls drawn
/// from a bag of red, green and blue cubes. A game is possible when no single
/// handful ever exceeded 12 red, 13 green or 14 blue. Sum the ids of the
/// possible games — 1 + 2 + 5 = 8 on `sample.txt`.
///
/// Advent of Code 2023, day 2, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type FsErr =
  | Denied(path: Str)
  | NotFound(path: Str)

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

/// One handful. A single `4 red` parses to a `Draw` with the other two colours
/// zero, so a whole handful is just those merged together.
type Draw = { blue: Int, green: Int, red: Int }

type Game = { draws: List[Draw], id: Int }

fn fs_message(error: FsErr) -> Str {
  match error {
    Denied(path) => "denied " ++ path
    NotFound(path) => "not found " ++ path
  }
}

fn read_lines(fs: Fs, path: Str) -> Result[List[Str], Str] {
  match fs.read(path) {
    Err(error) => Err("could not read " ++ path ++ ": " ++ fs_message(error))
    Ok(text) => Ok(text.trim().split("\n").reject(fn(line) { line == "" }))
  }
}

fn Draw.zero() -> Draw {
  { blue: 0, green: 0, red: 0 }
}

/// Colours never repeat inside one handful, so taking the larger of each field
/// merges two partial draws without double-counting.
fn Draw.max(a: Draw, b: Draw) -> Draw {
  { blue: Int.max(a.blue, b.blue), green: Int.max(a.green, b.green), red: Int.max(a.red, b.red) }
}

fn parse_cube(text: Str) -> Result[Draw, Str] {
  let parts = text.trim().words()
  let count = Int.parse(parts.get(0).ok_or("expected `<count> <colour>`, got: " ++ text)?)?
  let colour = parts.get(1).ok_or("expected `<count> <colour>`, got: " ++ text)?
  if colour == "red" {
    Ok({ blue: 0, green: 0, red: count })
  } else if colour == "green" {
    Ok({ blue: 0, green: count, red: 0 })
  } else if colour == "blue" {
    Ok({ blue: count, green: 0, red: 0 })
  } else {
    Err("unknown colour: " ++ colour)
  }
}

fn parse_draw(text: Str) -> Result[Draw, Str] {
  Ok(text.split(",").try_map(parse_cube)?.fold(Draw.zero(), Draw.max))
}

fn parse_game(line: Str) -> Result[Game, Str] {
  let halves = line.split(":")
  let heading = halves.get(0).ok_or("expected `Game <id>: ...`, got: " ++ line)?
  let body = halves.get(1).ok_or("expected `Game <id>: ...`, got: " ++ line)?
  let id = Int.parse(heading.words().get(1).ok_or("expected `Game <id>`, got: " ++ heading)?)?
  Ok({ draws: body.split(";").try_map(parse_draw)?, id: id })
}

fn possible(game: Game) -> Bool {
  game.draws.all(fn(draw) { draw.red <= 12 and draw.green <= 13 and draw.blue <= 14 })
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let games = read_lines(sys.fs, path)?.try_map(parse_game)?
  let total = games.filter(possible).map(fn(game) { game.id }).sum()
  sys.console.print("sum of possible game ids: " ++ Int.to_str(total))
  Ok(())
}
