/// The same games, asked backwards: for each one, the fewest cubes of each
/// colour the bag must have held. That is the per-colour maximum across the
/// handfuls — the same `Draw.max` merge part 1 used within a handful, run across
/// all of them. Multiply the three, sum over games: 48 + 12 + 1560 + 630 + 36 =
/// 2286 on `sample.txt`.
///
/// Advent of Code 2023, day 2, part 2. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part2.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

type Draw = { blue: Int, green: Int, red: Int }

type Game = { draws: List[Draw], id: Int }

fn Draw.zero() -> Draw {
  { blue: 0, green: 0, red: 0 }
}

fn Draw.max(a: Draw, b: Draw) -> Draw {
  { blue: Int.max(a.blue, b.blue), green: Int.max(a.green, b.green), red: Int.max(a.red, b.red) }
}

fn parse_cube(text: Str) -> Result[Draw, Str] {
  let parts = text.trim().words()
  let malformed = "expected `<count> <colour>`, got: " ++ text
  let count = Int.parse(parts.get(0).ok_or(malformed)?)?
  match parts.get(1).ok_or(malformed)? {
    "red" => Ok({ blue: 0, green: 0, red: count })
    "green" => Ok({ blue: 0, green: count, red: 0 })
    "blue" => Ok({ blue: count, green: 0, red: 0 })
    colour => Err("unknown colour: " ++ colour)
  }
}

fn parse_draw(text: Str) -> Result[Draw, Str] {
  Ok(text.split(",").try_map(parse_cube)?.fold(Draw.zero(), Draw.max))
}

fn parse_game(line: Str) -> Result[Game, Str] {
  let malformed = "expected `Game <id>: ...`, got: " ++ line
  let halves = line.split(":")
  let heading = halves.get(0).ok_or(malformed)?
  let body = halves.get(1).ok_or(malformed)?
  let id = Int.parse(heading.words().get(1).ok_or("expected `Game <id>`, got: " ++ heading)?)?
  Ok({ draws: body.split(";").try_map(parse_draw)?, id: })
}

/// The smallest bag that could have played this game.
fn fewest(game: Game) -> Draw {
  game.draws.fold(Draw.zero(), Draw.max)
}

fn power(draw: Draw) -> Int {
  draw.red * draw.green * draw.blue
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let games = Fs.read_lines(sys.fs.read, path)?.reject(fn(line) { line == "" }).try_map(parse_game)?
  let total = games.map(fn(game) { power(fewest(game)) }).sum()
  sys.console.print("sum of set powers: " ++ Int.to_str(total))
  Ok(())
}
