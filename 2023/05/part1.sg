/// The almanac is a seed list followed by seven layers of mapping rules. Each
/// rule is `<destination start> <source start> <length>`; a number the layer says
/// nothing about passes through unchanged. Push every seed down through all seven
/// layers and report the lowest location: 35 on `sample.txt`.
///
/// Advent of Code 2023, day 5, part 1. A Sigil implementation —
/// https://github.com/gstark/sigil — run with `sigil exec part1.sg -- input.txt`.
type Console = { print: fn(Str) -> Unit }

type FsErr =
  | Denied(path: Str)
  | NotFound(path: Str)

type Fs = { read: fn(Str) -> Result[Str, FsErr] }

type Sys = { console: Console, fs: Fs, args: List[Str] }

/// One mapping rule: sources `src` through `src + len` land `dst - src` away.
type Rule = { dst: Int, len: Int, src: Int }

type Almanac = { layers: List[List[Rule]], seeds: List[Int] }

fn fs_message(error: FsErr) -> Str {
  match error {
    Denied(path) => "denied " ++ path
    NotFound(path) => "not found " ++ path
  }
}

fn read_text(fs: Fs, path: Str) -> Result[Str, Str] {
  match fs.read(path) {
    Err(error) => Err("could not read " ++ path ++ ": " ++ fs_message(error))
    Ok(text) => Ok(text.trim())
  }
}

fn parse_rule(line: Str) -> Result[Rule, Str] {
  let parts = parse_numbers(line)?
  if parts.len() != 3 {
    Err("expected `<dst> <src> <len>`, got: " ++ line)
  } else {
    Ok({
      dst: parts.get(0).unwrap_or(0),
      len: parts.get(2).unwrap_or(0),
      src: parts.get(1).unwrap_or(0),
    })
  }
}

/// A block is its `x-to-y map:` heading and then the rules, so the heading is
/// dropped. The layers are applied in file order, which is already the order the
/// puzzle chains them in — no need to read the names.
fn parse_layer(block: Str) -> Result[List[Rule], Str] {
  block.trim().lines().drop(1).try_map(parse_rule)
}

fn parse_almanac(text: Str) -> Result[Almanac, Str] {
  let blocks = text.split("\n\n")
  let head = blocks.get(0).ok_or("empty almanac")?
  let seeds = head.split(":").get(1).ok_or("expected a `seeds:` line, got: " ++ head)?
  Ok({ layers: blocks.drop(1).try_map(parse_layer)?, seeds: parse_numbers(seeds)? })
}

fn parse_numbers(text: Str) -> Result[List[Int], Str] {
  text.words().try_map(Int.parse)
}

fn convert(rules: List[Rule], value: Int) -> Int {
  match List.find(rules, fn(rule) { value >= rule.src and value < rule.src + rule.len }) {
    None => value
    Some(rule) => rule.dst + value - rule.src
  }
}

fn locate(layers: List[List[Rule]], seed: Int) -> Int {
  layers.fold(seed, fn(value, rules) { convert(rules, value) })
}

fn main(sys: Sys) -> Result[Unit, Str] {
  let path = sys.args.first().unwrap_or("input.txt")
  let almanac = parse_almanac(read_text(sys.fs, path)?)?
  let lowest = almanac.seeds.map(fn(seed) { locate(almanac.layers, seed) }).min()
  sys.console.print("lowest location: " ++ Int.to_str(lowest.ok_or("no seeds")?))
  Ok(())
}
